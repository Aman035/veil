{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unlink",
  "version": "0.1.0",
  "identifier": "org.unlink.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Unlink",
        "width": 940,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
